# Independent project; application COMPOSE_* settings are deliberately ignored.
# Optional per-volume overrides. restart.sh migrate records actual old volume names in
# .volumes.json, which takes precedence over these defaults. Back up that file.
N_OBSERVABILITY_TEMPO_VOLUME=n-observability_tempo-data
N_OBSERVABILITY_PROMETHEUS_VOLUME=n-observability_prometheus-data
N_OBSERVABILITY_GRAFANA_VOLUME=n-observability_grafana-data
N_OBSERVABILITY_LOKI_VOLUME=n-observability_loki-data
N_OBSERVABILITY_PYROSCOPE_VOLUME=n-observability_pyroscope-data
N_OBSERVABILITY_PYROSCOPE_DATA_VOLUME=n-observability_pyroscope-storage
N_OBSERVABILITY_PYROSCOPE_COMPACTOR_VOLUME=n-observability_pyroscope-compactor
N_OBSERVABILITY_PYROSCOPE_METASTORE_VOLUME=n-observability_pyroscope-metastore
