{
  "uid": "nkb-overview",
  "title": "N-KB Overview",
  "tags": [
    "n-kb",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": "Prometheus",
        "includeAll": true,
        "multi": false,
        "query": {
          "qryType": 1,
          "query": "label_values(nkb_document_upload_duration_seconds_count, service_name)"
        },
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "N-KB 大盘",
      "tags": [
        "n-kb"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "上传吞吐（按终态）",
      "description": "success/error/cancelled 单列，先对每序列 rate 再汇总。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(nkb_document_uploads_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "上传耗时 p95",
      "description": "覆盖全部终态；跨实例按bucket聚合，不平均实例分位数。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nkb_document_upload_duration_seconds_bucket{service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "索引吞吐（按终态）",
