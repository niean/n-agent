      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nkb_index_chunks_sum{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "chunks/s",
          "exemplar": true
        }
      ]
    },
