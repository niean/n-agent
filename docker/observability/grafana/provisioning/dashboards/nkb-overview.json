          "legendFormat": "{{gen_ai_request_model}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Embedding 输入 Token 速率",
      "description": "Histogram sum为已知token总量，未知用量不补零。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tps",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_token_usage_sum{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{gen_ai_request_model}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "进程 CPU 时间速率",
      "description": "CPU秒/秒；不等同于核数归一的CPU百分比。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_instance_id) (rate(process_cpu_time_seconds_total{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_instance_id}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "进程内存 RSS",
      "description": "同N-Agent SystemMetricsInstrumentor的process.memory.usage。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_instance_id) (process_memory_usage_bytes{service_name=~\"$service\"})",
