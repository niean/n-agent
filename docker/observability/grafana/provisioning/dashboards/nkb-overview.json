      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nkb_retrieval_results_bucket{service_name=~\"$service\",le=\"0\"}[$__rate_interval])) / (sum(rate(nkb_retrieval_results_count{service_name=~\"$service\"}[$__rate_interval])) > 0)",
          "legendFormat": "empty / success",
          "exemplar": true
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Embedding 耗时 p95",
      "description": "仅真实embedding调用；包含失败，按配置模型分组。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
