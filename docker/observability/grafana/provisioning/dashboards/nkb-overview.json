      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nkb_index_chunks_bucket{service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "chunks p95",
          "exemplar": true
