    {
      "id": 9,
      "type": "timeseries",
      "title": "上传错误率",
      "description": "分母success+error，取消单列。未产生error序列或分母为零时无数据。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nkb_document_uploads_total{service_name=~\"$service\",outcome=\"error\"}[$__rate_interval])) / (sum(rate(nkb_document_uploads_total{service_name=~\"$service\",outcome=~\"success|error\"}[$__rate_interval])) > 0)",
          "legendFormat": "error / completed",
          "exemplar": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "索引错误率",
      "description": "分母success+error，取消单列。未产生error序列或分母为零时无数据。",
