      "id": 15,
      "type": "timeseries",
      "title": "成功检索结果数 p95",
      "description": "仅成功检索，0结果有独立bucket。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nkb_retrieval_results_bucket{service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "results p95",
          "exemplar": true
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "成功检索空命中率",
      "description": "零结果bucket / 成功结果样本数；零分母无数据。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 29
