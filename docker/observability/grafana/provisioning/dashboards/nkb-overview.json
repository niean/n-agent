    {
      "id": 14,
      "type": "timeseries",
      "title": "成功索引 chunk 速率",
      "description": "仅成功索引chunk总量/秒。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 15,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "无数据"
