      "id": 13,
      "type": "timeseries",
      "title": "成功索引 chunk 分布 p95",
      "description": "仅成功索引的实际chunk数。",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 6,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据"
        },
        "overrides": []
