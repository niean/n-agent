{
  "uid": "nagent-logs",
  "title": "Logs",
  "tags": [
    "n-agent",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1,
        "query": {
          "type": 1,
          "label": "service_name",
          "refId": "LokiVariableQuery"
        },
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 3,
      "type": "timeseries",
      "title": "Log rate (all vs error)",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service_name=~\"$service\"}[5m]))",
          "legendFormat": "all",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "sum(rate({service_name=~\"$service\"} |= \"ERROR\" [5m]))",
          "legendFormat": "error",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "queryType": "range",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Application logs",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\"}",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "queryType": "range",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Errors only",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\"} |= \"ERROR\"",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "queryType": "range",
          "editorMode": "code"
        }
      ]
    }
  ]
