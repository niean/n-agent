{
  "uid": "nkb-logs",
  "title": "N-KB Logs",
  "tags": [
    "n-kb",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "P8E80F9AEF21F6940"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": false,
        "refresh": 1,
        "query": {
          "type": 1,
          "label": "service_name",
          "refId": "LokiVariableQuery"
        },
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "title": "N-KB 大盘",
      "tags": [
        "n-kb"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 3,
      "title": "Log rate (all vs error)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "description": "规范属性保存在 context.execution（例如 nkb.index.operation/outcome），安全内容信封保存在 details；完成事件 nkb.document/index/retrieval/model/mcp/http.completed。HTTP 由 nkb.http.direction 区分；index 由 nkb.index.operation 区分 run 与阶段。取消与拒绝不自动视为技术错误。旧时间范围可能不完整。",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service_name=~\"$service\"}[5m]))",
          "legendFormat": "all",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "queryType": "range",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "sum(rate({service_name=~\"$service\"} | json | severity=\"ERROR\" [5m]))",
          "legendFormat": "error",
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "queryType": "range",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 1,
      "title": "Application logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
