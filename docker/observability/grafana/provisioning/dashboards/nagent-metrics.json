{
  "uid": "nagent-metrics",
  "title": "Metrics",
  "tags": [
    "n-agent",
    "genai",
    "metrics"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": "Prometheus",
        "includeAll": true,
        "multi": false,
        "query": {
          "qryType": 1,
          "query": "label_values(gen_ai_invoke_agent_duration_seconds_count, service_name)"
        },
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Turns / s",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nagent_turns_total{service_name=~\"$service\"}[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Inference calls / s",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gen_ai_client_inference_duration_seconds_count{service_name=~\"$service\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tool calls / s",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gen_ai_execute_tool_duration_seconds_count{service_name=~\"$service\"}[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Input tokens / s",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gen_ai_client_inference_usage_input_tokens_total{service_name=~\"$service\"}[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Output tokens / s",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gen_ai_client_inference_usage_output_tokens_total{service_name=~\"$service\"}[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Budget denials (5m)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(nagent_budget_denied_total{service_name=~\"$service\"}[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM inference latency (p50/p95/p99)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_inference_duration_seconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_inference_duration_seconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_client_inference_duration_seconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "p99",
          "exemplar": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Turn rate by end reason",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (nagent_end_reason) (rate(nagent_turns_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{nagent_end_reason}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Token throughput by model (input)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "tps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_inference_usage_input_tokens_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "in {{gen_ai_request_model}}"
        },
        {
          "refId": "B",
          "expr": "sum by (gen_ai_request_model) (rate(gen_ai_client_inference_usage_output_tokens_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "out {{gen_ai_request_model}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Turn rate by source",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (nagent_source) (rate(nagent_turns_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{nagent_source}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Execution duration p95 (tool / agent run)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_execute_tool_duration_seconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "tool p95",
          "exemplar": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_invoke_agent_duration_seconds_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "agent run p95",
          "exemplar": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Guardrails (compression / budget denial rate)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nagent_context_compressions_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "compressions"
        },
        {
          "refId": "B",
          "expr": "sum(rate(nagent_budget_denied_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "budget denials"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Token count per inference (p95)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_inference_operation_input_tokens_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "input p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_inference_operation_output_tokens_bucket{service_name=~\"$service\"}[5m])))",
          "legendFormat": "output p95"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Calls per agent run",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gen_ai_invoke_agent_inference_calls_count{service_name=~\"$service\"}[5m])) / clamp_min(sum(rate(gen_ai_invoke_agent_duration_seconds_count{service_name=~\"$service\"}[5m])), 1e-9)",
          "legendFormat": "inference / run"
        },
        {
          "refId": "B",
          "expr": "sum(rate(gen_ai_invoke_agent_tool_calls_count{service_name=~\"$service\"}[5m])) / clamp_min(sum(rate(gen_ai_invoke_agent_duration_seconds_count{service_name=~\"$service\"}[5m])), 1e-9)",
          "legendFormat": "tool / run"
        }
      ]
    }
  ]
}
