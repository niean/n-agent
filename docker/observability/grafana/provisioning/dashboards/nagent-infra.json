{
  "uid": "nagent-infra",
  "title": "Resources",
  "tags": [
    "n-agent",
    "resources"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": "Prometheus",
        "includeAll": true,
        "multi": false,
        "query": {
          "qryType": 1,
          "query": "label_values(system_cpu_utilization_ratio, service_name)"
        },
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Agent CPU (util %)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_utilization_ratio{service_name=~\"$service\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agent Memory (RSS)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_memory_usage_bytes{service_name=~\"$service\"}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "System CPU (util %)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system_cpu_utilization_ratio{service_name=~\"$service\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "System Memory (util %)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system_memory_utilization_ratio{service_name=~\"$service\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Agent process CPU utilization",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_utilization_ratio{service_name=~\"$service\"}",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Agent process memory",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_memory_usage_bytes{service_name=~\"$service\"}",
          "legendFormat": "rss"
        },
        {
          "refId": "B",
          "expr": "process_memory_virtual_bytes{service_name=~\"$service\"}",
          "legendFormat": "virtual"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "System CPU time by state",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (rate(system_cpu_time_seconds_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "System memory by state",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "system_memory_usage_bytes{service_name=~\"$service\"}",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "System disk I/O",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(system_disk_io_bytes_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "System network I/O",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(system_network_io_bytes_total{service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Observability stack up",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} {{instance}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Collector pipeline throughput",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(otelcol_receiver_accepted_log_records_total[5m]))",
          "legendFormat": "log records in"
        },
        {
          "refId": "B",
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[5m]))",
          "legendFormat": "metric points in"
        },
        {
          "refId": "C",
          "expr": "sum(rate(otelcol_receiver_refused_log_records_total[5m]))",
          "legendFormat": "log records refused"
        },
        {
          "refId": "D",
          "expr": "sum(rate(otelcol_receiver_refused_metric_points_total[5m]))",
          "legendFormat": "metric points refused"
        },
        {
          "refId": "E",
          "expr": "sum(rate(otelcol_exporter_prometheusremotewrite_sent_batches_total[5m]))",
          "legendFormat": "PRW batches out"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Collector process",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "otelcol_process_memory_rss_bytes",
          "legendFormat": "rss"
        },
        {
          "refId": "B",
          "expr": "rate(otelcol_process_cpu_seconds_total[5m])",
          "legendFormat": "cpu cores"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Loki write traffic",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(loki_request_duration_seconds_count{route=~\"otlp_v1_logs|/logproto.Pusher/Push\"}[5m]))",
          "legendFormat": "ingest req/s"
        }
      ]
    }
  ]
}
