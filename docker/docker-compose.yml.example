name: n-agent

# 沙盒 Docker 后端开启说明（sandbox_type=docker）：
#   1) 取消下方 docker.sock 挂载注释；
#   2) 容器内 docker CLI 可用（见 docker/Dockerfile 中 docker-ce-cli 安装）；
#   3) 配置 N_AGENT_SANDBOX_DOCKER_HOST_WORKSPACE_ROOT 与
#      N_AGENT_SANDBOX_DOCKER_HOST_LOCALS_ROOT 指向宿主路径，须与下方 volumes
#      挂载源一致（workspace 与 locals 的宿主路径），否则兄弟沙盒容器 -v 挂载
#      到不存在的宿主目录。scratch 默认复用 locals/sandbox-scratch。
#   注：宿主路径以实际部署机为准。

services:
  n-agent:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    env_file:
      - path: ./.env
        required: false
    environment:
      TZ: Asia/Shanghai
      N_AGENT_SQLITE_PATH: /app/locals/sessions.db
      N_AGENT_WORKSPACE_ROOT: /workspace
      N_AGENT_AGENT_ITERATION_LIMIT: 5
    ports:
      - "8201:8201"
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8201/health', timeout=2).read()"]
      interval: 10s
      timeout: 3s
      retries: 6
      start_period: 10s
    volumes:
      - ~/app/locals:/app/locals
      - ~/workspace:/workspace
      # 沙盒 Docker 后端：sandbox_type=docker 时取消注释，并确保容器内 docker CLI 可用（见 Dockerfile）
      # - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - default
      - n-kb

networks:
  n-kb:
    name: n-kb_default
    external: true
