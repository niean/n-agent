name: n-agent

# 沙盒 Docker 后端开启说明（sandbox_type=docker）：
#   1) 取消下方 docker.sock 挂载注释；
#   2) 容器内 docker CLI 可用（见 docker/Dockerfile 中 docker.io 安装）；
#   3) 容器内 docker 组权限（已在 Dockerfile 中配置）；
#   4) 配置 N_AGENT_SANDBOX_DOCKER_HOST_WORKSPACE_ROOT 与
#      N_AGENT_SANDBOX_DOCKER_HOST_LOCALS_ROOT 指向宿主路径，须与下方 volumes
#      挂载源一致（workspace 与 locals 的宿主路径），否则兄弟沙盒容器 -v 挂载
#      到不存在的宿主目录。scratch 默认复用 locals/sandbox-scratch。
#   注：宿主路径以实际部署机为准。

# 本文件是无迁移包时的冷启动模板，使用 ~/app/... 占位与 ${VAR:-default}，
# 可在没有 docker/.env 的情况下 `docker compose config` 通过。
# 实际部署的 docker-compose.yml 改用两个必填变量：
#   N_AGENT_INSTALL_ROOT -- 数据根（logs/locals/workspace/browser-profiles/secrets）
#   N_AGENT_CODE_ROOT    -- 宿主代码根（ACP 挂载到 /workspace-code）
# 迁移安装请用 docker/install.sh，compose 由迁移包携带。

services:
  n-agent:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    depends_on:
      browser:
        condition: service_healthy
    env_file:
      - path: ./.env
        required: false
    environment:
      TZ: Asia/Shanghai
      N_AGENT_OTEL_CONTENT_MAX_BYTES: ${N_AGENT_OTEL_CONTENT_MAX_BYTES:-2048}
      N_AGENT_SQLITE_PATH: /app/locals/sessions.db
      N_AGENT_WORKSPACE_ROOT: /workspace
      N_AGENT_AGENT_ITERATION_LIMIT: ${N_AGENT_AGENT_ITERATION_LIMIT:-10}
      N_AGENT_HOST_TERMINAL_ENABLED: ${N_AGENT_HOST_TERMINAL_ENABLED:-false}
      N_AGENT_HOST_TERMINAL_BRIDGE_URL: ${N_AGENT_HOST_TERMINAL_BRIDGE_URL:-http://host.docker.internal:8765}
      N_AGENT_HOST_TERMINAL_POLICY_PATH: /app/locals/host-terminal-policy.yaml
      N_AGENT_HOST_TERMINAL_TOKEN_PATH: /app/locals/host-terminal.token
      N_AGENT_HOST_TERMINAL_HOST_WORKSPACE_ROOT: ${N_AGENT_HOST_TERMINAL_HOST_WORKSPACE_ROOT:-/Users/you/app/workspace}
      N_AGENT_HOST_TERMINAL_HOST_SKILLS_ROOT: ${N_AGENT_HOST_TERMINAL_HOST_SKILLS_ROOT:-/Users/you/app/workspace/skills}
      N_AGENT_HOST_TERMINAL_TOOL_TIMEOUT_SECONDS: ${N_AGENT_HOST_TERMINAL_TOOL_TIMEOUT_SECONDS:-120}
      N_AGENT_HOST_TERMINAL_BRIDGE_TIMEOUT_SECONDS: ${N_AGENT_HOST_TERMINAL_BRIDGE_TIMEOUT_SECONDS:-120}
      N_AGENT_HOST_TERMINAL_CONNECT_TIMEOUT_SECONDS: ${N_AGENT_HOST_TERMINAL_CONNECT_TIMEOUT_SECONDS:-2}
      N_AGENT_HOST_TERMINAL_TRANSFER_MARGIN_SECONDS: ${N_AGENT_HOST_TERMINAL_TRANSFER_MARGIN_SECONDS:-5}
      N_AGENT_HOST_TERMINAL_MAX_RESPONSE_BYTES: ${N_AGENT_HOST_TERMINAL_MAX_RESPONSE_BYTES:-1048576}
      N_AGENT_HOST_TERMINAL_MAX_STDOUT_BYTES: ${N_AGENT_HOST_TERMINAL_MAX_STDOUT_BYTES:-8192}
      N_AGENT_HOST_TERMINAL_MAX_STDERR_BYTES: ${N_AGENT_HOST_TERMINAL_MAX_STDERR_BYTES:-8192}
      N_AGENT_HOST_TERMINAL_MAX_CONCURRENCY: ${N_AGENT_HOST_TERMINAL_MAX_CONCURRENCY:-1}
      # ACP 路径映射：VsCode ACP Client 发来的 host cwd 须在 HOST_WORKSPACE_ROOT 下，
      # 否则 session/new 拒绝。HOST root 须与下方 volumes 挂载源一致（或为其父目录），
      # CONTAINER root 须与挂载目标一致。详见 README.md "ACP 远程接入" 章节。
      N_AGENT_ACP_HOST_WORKSPACE_ROOT: ${N_AGENT_ACP_HOST_WORKSPACE_ROOT:-/Users/you/code}
      N_AGENT_ACP_CONTAINER_WORKSPACE_ROOT: /workspace-code
      # Browser 子域 (T11): container backend connects to the browser service
      # via CDP on the internal network. Enabled only when N_AGENT_BROWSER_ENABLED=true.
      N_AGENT_BROWSER_ENABLED: ${N_AGENT_BROWSER_ENABLED:-false}
      N_AGENT_BROWSER_CONTAINER_ENDPOINT: ${N_AGENT_BROWSER_CONTAINER_ENDPOINT:-http://172.19.0.10:9222}
      N_AGENT_BROWSER_CONTAINER_PROFILE_RUNTIME_ENDPOINT: ${N_AGENT_BROWSER_CONTAINER_PROFILE_RUNTIME_ENDPOINT:-http://browser:9223}
      N_AGENT_BROWSER_CONTAINER_NOVNC_ENDPOINT: ${N_AGENT_BROWSER_CONTAINER_NOVNC_ENDPOINT:-http://browser:6080}
      N_AGENT_BROWSER_HOST_BRIDGE_URL: ${N_AGENT_BROWSER_HOST_BRIDGE_URL:-http://host.docker.internal:8766}
      N_AGENT_BROWSER_HOST_BRIDGE_TOKEN_PATH: ${N_AGENT_BROWSER_HOST_BRIDGE_TOKEN_PATH:-/app/locals/host-browser.token}
      N_AGENT_BROWSER_TRUSTED_DEV: ${N_AGENT_BROWSER_TRUSTED_DEV:-false}
    ports:
      - "8201:8201"
    # 观测退出预算：应用 5 秒观测 shutdown 需在容器强杀前完成（spec 7）。
    stop_grace_period: 15s
    # Resource limits: bounded CPU/memory for the n-agent service.
    mem_limit: 1024m
    cpus: 2.0
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8201/health', timeout=2).read()"]
      interval: 10s
      timeout: 3s
      retries: 6
      start_period: 10s
    volumes:
      - ~/app/logs:/app/logs
      - ~/app/locals:/app/locals
      # Create these owner-only files first. They override the writable locals mount.
      - ~/app/locals/host-terminal-policy.yaml:/app/locals/host-terminal-policy.yaml:ro
      - ~/app/locals/host-terminal.token:/app/locals/host-terminal.token:ro
      - ~/app/locals/host-browser.token:/app/locals/host-browser.token:ro
      - ~/app/workspace:/workspace
      # ACP 远程接入：挂载宿主代码目录，供 VsCode ACP Client 访问容器内代码文件
      - ~/code:/workspace-code
      # 沙盒 Docker 后端：sandbox_type=docker 时取消注释，并确保容器内 docker CLI 可用（见 Dockerfile）
      # - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - default
      - n-kb

  # Container browser runtime (T11): Chromium + noVNC for interactive
  # takeover. CDP (9222) and noVNC (6080) ports are container-network only
  # (NO host port mapping). n-agent connects via http://browser:9222.
  # Resource limits enforce CPU/memory/pids/shm bounds per session.
  browser:
    build:
      context: ./browser
      dockerfile: Dockerfile
    environment:
      TZ: Asia/Shanghai
      CDP_PORT: 9222
      NOVNC_PORT: 6080
      VNC_PORT: 5900
      CHROMIUM_USER_DATA_DIR: /data/profiles
      SCREEN_WIDTH: 1280
      SCREEN_HEIGHT: 960
      SCREEN_DEPTH: 24
    # NO ports: section -- CDP/noVNC are container-network only.
    expose:
      - "9223"
      - "6080"
    volumes:
      - ~/app/browser-profiles:/data/profiles
    # Resource limits: single-session Chromium with bounded CPU/memory/pids.
    mem_limit: 512m
    cpus: 1.0
    pids_limit: 256
    shm_size: 256m
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:9223/health"]
      interval: 10s
      timeout: 3s
      retries: 6
      start_period: 15s
    networks:
      default:
        ipv4_address: 172.19.0.10

  # ---------------------------------------------------------------------------
  # 观测后端栈（spec 7，profile=observability）：Collector 三 pipeline
  # （traces->Tempo / metrics->Prometheus remote write / logs->Loki+stdout 证据）。
  # 仅启用 profile 不会打开应用 OTel 开关（N_AGENT_OTEL_ENABLED 来自 .env）；
  # n-agent 不依赖这些服务，后端不可达仅降级观测。
  # UI 端口绑定 127.0.0.1；Collector/Prometheus 默认不发布宿主端口。
  # Tempo 使用独立持久卷，Trace 保留 7 天。
  # ---------------------------------------------------------------------------
  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.137.0
    profiles: ["observability"]
    command: ["--config=/etc/otelcol-contrib/config.yaml"]
    volumes:
      - ./observability/otel-collector.yaml:/etc/otelcol-contrib/config.yaml:ro
    expose:
      - "4317"
      - "4318"
    # 宿主 OTLP 接入默认关闭（spec 7：默认仅容器内网接收）；需要宿主接入时取消注释：
    # ports:
    #   - "127.0.0.1:4317:4317"
    stop_grace_period: 15s
    mem_limit: 384m
    cpus: 0.5
    healthcheck:
      test: ["CMD", "/otelcol-contrib", "validate", "--config=/etc/otelcol-contrib/config.yaml"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  tempo:
    image: grafana/tempo:2.9.0
    profiles: ["observability"]
    command: ["-config.file=/etc/tempo/config.yaml"]
    # Named volume starts owned by root; match the other local observability stores.
    user: "0:0"
    volumes:
      - ./observability/tempo.yaml:/etc/tempo/config.yaml:ro
      - tempo-data:/var/tempo
    expose:
      - "4317"
    ports:
      - "127.0.0.1:3200:3200"
    stop_grace_period: 15s
    mem_limit: 512m
    cpus: 0.5
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  prometheus:
    image: prom/prometheus:v3.15.1
    profiles: ["observability"]
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=7d
      - --web.enable-remote-write-receiver
      - --enable-feature=exemplar-storage
    volumes:
      - ./observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    stop_grace_period: 15s
    mem_limit: 512m
    cpus: 0.5
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://localhost:9090/-/healthy"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  grafana:
    image: grafana/grafana:13.0.11
    profiles: ["observability"]
    # 本地 127.0.0.1 只读观测 UI：匿名 Viewer，无登录凭据（不引入秘密）。
    environment:
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Viewer
      GF_AUTH_DISABLE_LOGIN_FORM: "false"
      GF_USERS_DEFAULT_THEME: light
    volumes:
      - ./observability/grafana/provisioning:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana
    ports:
      # 宿主侧改绑 13000 避开常见被占用的 3000（按部署机实际情况调整）
      - "127.0.0.1:13000:3000"
    stop_grace_period: 15s
    mem_limit: 512m
    cpus: 0.5
    healthcheck:
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:3000/api/health"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  pyroscope:
    image: grafana/pyroscope:1.21.1
    profiles: ["observability"]
    # 注：pyroscope 镜像为 distroless（无 shell/wget/curl），无可用 in-image
    # 探针，故不定义 healthcheck；依赖方不得对其使用 service_healthy 条件。
    command: ["-config.file=/etc/pyroscope/config.yaml"]
    volumes:
      - ./observability/pyroscope.yaml:/etc/pyroscope/config.yaml:ro
      - pyroscope-data:/var/lib/pyroscope
    ports:
      - "127.0.0.1:4040:4040"
    stop_grace_period: 15s
    mem_limit: 512m
    cpus: 0.5
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  loki:
    image: grafana/loki:3.5.5
    profiles: ["observability"]
    # 日志后端：原生 OTLP 接收（/otlp/v1/logs），Grafana 经 Loki 数据源查询；
    # 默认不发布宿主端口（与 Prometheus 一致，仅容器内网 + Grafana 代理）。
    command: ["-config.file=/etc/loki/config.yaml"]
    volumes:
      - ./observability/loki.yaml:/etc/loki/config.yaml:ro
      - loki-data:/loki
    expose:
      - "3100"
    stop_grace_period: 15s
    mem_limit: 384m
    cpus: 0.5
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "-", "http://localhost:3100/ready"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  default:
    ipam:
      config:
        - subnet: 172.19.0.0/16
  n-kb:
    name: n-kb_default
    external: true

volumes:
  # Persistent browser profiles (per profile_ref opaque key).
  browser-profiles:
  # 观测栈命名卷：Prometheus 指标 7 天（--storage.tsdb.retention.time=7d）、
  # Pyroscope profile 7 天（compactor_blocks_retention_period=168h）、
  # Grafana 状态、Loki 日志 7 天（limits_config.retention_period=168h）；由 compose 统一管理。
  tempo-data:
  prometheus-data:
  grafana-data:
  pyroscope-data:
  loki-data:
