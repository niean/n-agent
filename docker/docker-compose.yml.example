name: n-agent

# 沙盒 Docker 后端开启说明（sandbox_type=docker）：
#   1) 取消下方 docker.sock 挂载注释；
#   2) 容器内 docker CLI 可用（见 docker/Dockerfile 中 docker-ce-cli 安装）；
#   3) 配置 N_AGENT_SANDBOX_DOCKER_HOST_WORKSPACE_ROOT 与
#      N_AGENT_SANDBOX_DOCKER_HOST_LOCALS_ROOT 指向宿主路径，须与下方 volumes
#      挂载源一致（workspace 与 locals 的宿主路径），否则兄弟沙盒容器 -v 挂载
#      到不存在的宿主目录。scratch 默认复用 locals/sandbox-scratch。
#   注：宿主路径以实际部署机为准。

services:
  n-agent:
    build:
      context: ..
      dockerfile: docker/Dockerfile
    env_file:
      - path: ./.env
        required: false
    environment:
      TZ: Asia/Shanghai
      N_AGENT_SQLITE_PATH: /app/locals/sessions.db
      N_AGENT_WORKSPACE_ROOT: /workspace
      N_AGENT_AGENT_ITERATION_LIMIT: ${N_AGENT_AGENT_ITERATION_LIMIT:-10}
      N_AGENT_HOST_TERMINAL_ENABLED: ${N_AGENT_HOST_TERMINAL_ENABLED:-false}
      N_AGENT_HOST_TERMINAL_BRIDGE_URL: ${N_AGENT_HOST_TERMINAL_BRIDGE_URL:-http://host.docker.internal:8765}
      N_AGENT_HOST_TERMINAL_POLICY_PATH: /app/locals/host-terminal-policy.yaml
      N_AGENT_HOST_TERMINAL_TOKEN_PATH: /app/locals/host-terminal.token
      N_AGENT_HOST_TERMINAL_HOST_WORKSPACE_ROOT: ${N_AGENT_HOST_TERMINAL_HOST_WORKSPACE_ROOT:-/Users/you/app/workspace}
      N_AGENT_HOST_TERMINAL_HOST_SKILLS_ROOT: ${N_AGENT_HOST_TERMINAL_HOST_SKILLS_ROOT:-/Users/you/app/workspace/skills}
      N_AGENT_HOST_TERMINAL_TOOL_TIMEOUT_SECONDS: ${N_AGENT_HOST_TERMINAL_TOOL_TIMEOUT_SECONDS:-120}
      N_AGENT_HOST_TERMINAL_BRIDGE_TIMEOUT_SECONDS: ${N_AGENT_HOST_TERMINAL_BRIDGE_TIMEOUT_SECONDS:-120}
      N_AGENT_HOST_TERMINAL_CONNECT_TIMEOUT_SECONDS: ${N_AGENT_HOST_TERMINAL_CONNECT_TIMEOUT_SECONDS:-2}
      N_AGENT_HOST_TERMINAL_TRANSFER_MARGIN_SECONDS: ${N_AGENT_HOST_TERMINAL_TRANSFER_MARGIN_SECONDS:-5}
      N_AGENT_HOST_TERMINAL_MAX_RESPONSE_BYTES: ${N_AGENT_HOST_TERMINAL_MAX_RESPONSE_BYTES:-1048576}
      N_AGENT_HOST_TERMINAL_MAX_STDOUT_BYTES: ${N_AGENT_HOST_TERMINAL_MAX_STDOUT_BYTES:-8192}
      N_AGENT_HOST_TERMINAL_MAX_STDERR_BYTES: ${N_AGENT_HOST_TERMINAL_MAX_STDERR_BYTES:-8192}
      N_AGENT_HOST_TERMINAL_MAX_CONCURRENCY: ${N_AGENT_HOST_TERMINAL_MAX_CONCURRENCY:-1}
      N_AGENT_BROWSER_DEFAULT_BACKEND: ${N_AGENT_BROWSER_DEFAULT_BACKEND:-container}
      N_AGENT_BROWSER_HOST_BRIDGE_URL: ${N_AGENT_BROWSER_HOST_BRIDGE_URL:-http://host.docker.internal:8766}
      N_AGENT_BROWSER_HOST_BRIDGE_TOKEN_PATH: ${N_AGENT_BROWSER_HOST_BRIDGE_TOKEN_PATH:-/app/locals/host-browser.token}
      N_AGENT_BROWSER_TRUSTED_DEV: ${N_AGENT_BROWSER_TRUSTED_DEV:-false}
    ports:
      - "8201:8201"
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8201/health', timeout=2).read()"]
      interval: 10s
      timeout: 3s
      retries: 6
      start_period: 10s
    volumes:
      - ~/app/locals:/app/locals
      # Create these owner-only files first. They override the writable locals mount.
      - ~/app/locals/host-terminal-policy.yaml:/app/locals/host-terminal-policy.yaml:ro
      - ~/app/locals/host-terminal.token:/app/locals/host-terminal.token:ro
      - ~/app/locals/host-browser.token:/app/locals/host-browser.token:ro
      - ~/workspace:/workspace
      # 沙盒 Docker 后端：sandbox_type=docker 时取消注释，并确保容器内 docker CLI 可用（见 Dockerfile）
      # - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - default
      - n-kb

networks:
  n-kb:
    name: n-kb_default
    external: true
