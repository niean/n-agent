# Deployment roots -- 工作 docker-compose.yml 必填（本 .example 不使用，仅作说明）
# INSTALL_ROOT 下需有 logs/ locals/ workspace/ browser-profiles/ secrets/
N_AGENT_INSTALL_ROOT=
N_AGENT_CODE_ROOT=

# Model Provider
N_AGENT_PROVIDER_BASE_URL=
N_AGENT_PROVIDER_API_KEY=
N_AGENT_PROVIDER_MODEL=

# Knowledge Base (N-KB)
N_AGENT_KB_ENABLED=false
N_AGENT_KB_BASE_URL=http://n-kb:8212
N_AGENT_KB_DEFAULT_TOP_K=5
N_AGENT_KB_DEFAULT_MIN_SCORE=0.5
N_AGENT_KB_TIMEOUT_SECONDS=10

# MCP Sites
N_AGENT_MCP_CONNECT_TIMEOUT_SECONDS=10
N_AGENT_MCP_MAX_TOOLS=50
N_AGENT_MCP_MAX_SCHEMA_BYTES=65536
N_AGENT_MCP_MAX_RESULT_BYTES=262144
# Development only: allows host.docker.internal/private/loopback MCP URLs.
N_AGENT_MCP_ALLOW_PRIVATE_HOSTS=false

# Gateway
N_AGENT_GATEWAY_ENABLED=true

# Feishu Bot
N_AGENT_FEISHU_ENABLED=false
N_AGENT_FEISHU_APP_ID=
N_AGENT_FEISHU_APP_SECRET=

# Sandbox (Docker 后端)
# 开启前需同时：(1) 取消 docker-compose.yml.example 中 docker.sock 挂载注释
# (2) 容器内 docker CLI 可用（见 docker/Dockerfile）
# (3) 配置 N_AGENT_SANDBOX_DOCKER_HOST_WORKSPACE_ROOT / _LOCALS_ROOT 指向宿主路径，
#     须与 docker-compose.yml.example volumes 挂载源一致
N_AGENT_SANDBOX_ENABLED=false
N_AGENT_SANDBOX_TYPE=docker
N_AGENT_SANDBOX_DOCKER_HOST_WORKSPACE_ROOT=
N_AGENT_SANDBOX_DOCKER_HOST_LOCALS_ROOT=
N_AGENT_SANDBOX_SCRATCH_ROOT=/app/locals/sandbox-scratch
# 空闲回收：沙盒容器空闲超过该秒数后协作式释放（默认 900s）
N_AGENT_SANDBOX_IDLE_SECONDS=900

# Browser
N_AGENT_BROWSER_ENABLED=false
N_AGENT_BROWSER_DEFAULT_BACKEND=host_cdp
N_AGENT_BROWSER_HOST_BRIDGE_URL=http://host.docker.internal:8766
N_AGENT_BROWSER_HOST_BRIDGE_TOKEN_PATH=/app/locals/host-browser.token
N_AGENT_BROWSER_TRUSTED_DEV=true

# System
N_AGENT_CONTEXT_COMPRESSION_TAIL_BUDGET_ENABLED=false

# Observability (OTel) -- 观测栈走 compose observability profile；
# 仅启用 profile 不会打开应用开关，需将实际值写入 docker/.env 由 n-agent
# 经 env_file 接收（endpoint 为空 = local-only，不建网络 exporter）。
N_AGENT_OTEL_ENABLED=false
N_AGENT_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
N_AGENT_OTEL_TRACES_SAMPLE_RATIO=1.0
# 浏览器外链（宿主可访问地址），为空时自检页隐藏对应链接；
# Metric/Log/Profile 为 Grafana 大盘，Trace 为 Grafana Explore（Tempo）
N_AGENT_OTEL_GRAFANA_METRICS_BASE_URL=http://127.0.0.1:13000/d/nagent-metrics
N_AGENT_OTEL_GRAFANA_LOGS_BASE_URL=http://127.0.0.1:13000/d/nagent-logs
N_AGENT_OTEL_GRAFANA_PROFILE_BASE_URL=http://127.0.0.1:13000/d/nagent-profile
N_AGENT_OTEL_GRAFANA_TRACES_BASE_URL=http://127.0.0.1:13000/explore
# 兼容旧部署：N_AGENT_OTEL_JAEGER_BASE_URL 仅在新 Trace URL 为空时回退

# Profiling (py-spy -> Pyroscope) -- 独立于 otel_enabled；启用须提供合法
# http/https 上传地址；容器 attach 需要 docker-compose.observability.yml
# 中的 SYS_PTRACE override（仅 Profile 验收时经 COMPOSE_FILE 合入）。
N_AGENT_PROFILING_ENABLED=false
N_AGENT_PROFILING_PYROSCOPE_ENDPOINT=http://pyroscope:4040
N_AGENT_PROFILING_INTERVAL_SECONDS=60

N_AGENT_HOST_TERMINAL_ENABLED=false
N_AGENT_HOST_TERMINAL_BRIDGE_URL=http://host.docker.internal:8765
N_AGENT_HOST_TERMINAL_TOOL_TIMEOUT_SECONDS=120
N_AGENT_HOST_TERMINAL_BRIDGE_TIMEOUT_SECONDS=120
N_AGENT_HOST_TERMINAL_CONNECT_TIMEOUT_SECONDS=2
N_AGENT_HOST_TERMINAL_TRANSFER_MARGIN_SECONDS=5
N_AGENT_HOST_TERMINAL_MAX_RESPONSE_BYTES=1048576
N_AGENT_HOST_TERMINAL_MAX_STDOUT_BYTES=8192
N_AGENT_HOST_TERMINAL_MAX_STDERR_BYTES=8192
N_AGENT_HOST_TERMINAL_MAX_CONCURRENCY=1
