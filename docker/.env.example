# Model Provider
N_AGENT_PROVIDER_BASE_URL=
N_AGENT_PROVIDER_API_KEY=
N_AGENT_PROVIDER_MODEL=

# Knowledge Base (N-KB)
N_AGENT_KB_ENABLED=false
N_AGENT_KB_BASE_URL=http://n-kb:8212
N_AGENT_KB_DEFAULT_TOP_K=5
N_AGENT_KB_DEFAULT_MIN_SCORE=0.5
N_AGENT_KB_TIMEOUT_SECONDS=10

# MCP Sites
N_AGENT_MCP_CONNECT_TIMEOUT_SECONDS=10
N_AGENT_MCP_MAX_TOOLS=50
N_AGENT_MCP_MAX_SCHEMA_BYTES=65536
N_AGENT_MCP_MAX_RESULT_BYTES=262144
# Development only: allows host.docker.internal/private/loopback MCP URLs.
N_AGENT_MCP_ALLOW_PRIVATE_HOSTS=false

# Gateway
N_AGENT_GATEWAY_ENABLED=true

# Feishu Bot
N_AGENT_FEISHU_ENABLED=false
N_AGENT_FEISHU_APP_ID=
N_AGENT_FEISHU_APP_SECRET=
N_AGENT_FEISHU_TENANT_KEY=
N_AGENT_FEISHU_ALLOWED_OPEN_IDS=
N_AGENT_FEISHU_ALLOWED_CHAT_IDS=
